{
  "name": "botads",
  "version": "1.1.1",
  "description": "Facebook Group Auto Post Bot for app.pronunreview.com",
  "main": "index.js",
  "scripts": {
    "test:social:ui": "node scripts/smoke-social-desktop.mjs",
    "check:source": "node scripts/check-source-length.mjs",
    "test:facebook:ui": "node scripts/smoke-facebook-pairing.mjs",
    "web:dev": "vite --config apps/web/vite.config.mjs",
    "web:build": "vite build --config apps/web/vite.config.mjs",
    "cloud:setup": "node scripts/setup-local.cjs",
    "cloud:dev": "wrangler dev --config wrangler.jsonc",
    "cloud:build": "wrangler deploy --dry-run --outdir .worker-build",
    "cloud:build:production": "wrangler deploy --dry-run --env production --outdir .worker-build",
    "cloud:deploy": "wrangler deploy --env production",
    "web:check": "wrangler pages functions build --cwd apps/web --outdir ../../.pages-build",
    "web:deploy": "npm run web:build && wrangler pages deploy --cwd apps/web --project-name botads-web --branch main",
    "desktop": "electron apps/companion/main.cjs",
    "desktop:build": "node scripts/build-desktop.cjs",
    "desktop:build:lite": "node scripts/build-desktop.cjs --lite",
    "desktop:build:mac": "node scripts/build-desktop-mac.cjs",
    "desktop:build:mac:lite": "node scripts/build-desktop-mac.cjs --lite",
    "desktop:build:mac:signed": "node scripts/build-desktop-mac.cjs --signed",
    "desktop:build:mac:lite:signed": "node scripts/build-desktop-mac.cjs --lite --signed",
    "test:saas": "node --test tests/*.test.mjs tests/*.test.cjs",
    "test:marketing:ui": "node scripts/smoke-marketing.mjs",
    "test": "node --test tests/regression.test.js tests/automation.test.js",
    "start": "node packages/automation/index.js",
    "login": "node packages/automation/login.js",
    "search-groups": "node packages/automation/search_groups.js",
    "select-groups": "node packages/automation/select_groups.js",
    "reconcile": "node packages/automation/reconcile_posts.js",
    "join-groups": "node packages/automation/join_groups.js",
    "get-groups": "node packages/automation/get_groups.js",
    "post": "node packages/automation/post.js",
    "preview": "node packages/automation/preview.js",
    "history": "node packages/automation/view_history.js",
    "generate-ai": "node packages/automation/create_ai_batch.js",
    "auto": "node packages/automation/automation.js",
    "plan": "node packages/automation/automation.js --dry-run",
    "doctor": "node packages/automation/doctor.js",
    "manage": "node packages/automation/manage.js",
    "report": "node packages/automation/manage.js report",
    "schedule": "node packages/automation/scheduler.js",
    "schedule:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-schedule.ps1",
    "schedule:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-schedule.ps1 -Remove",
    "stop": "node packages/automation/control.js stop",
    "resume": "node packages/automation/control.js resume"
  },
  "keywords": [
    "facebook",
    "auto-post",
    "playwright",
    "pronunreview"
  ],
  "author": "BotAds",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jose": "^6.2.17",
    "playwright": "^1.58.2"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.1",
      "sharp": "^0.35.5"
    },
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  }
}
