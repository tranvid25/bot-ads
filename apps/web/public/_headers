/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://cdn.bsky.app https://*.bsky.network https://*.googleusercontent.com https://*.licdn.com; connect-src 'self' https://cloudflareinsights.com https://bsky.social https://*.bsky.network; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/client-metadata.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
